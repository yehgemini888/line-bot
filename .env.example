# Line Bot Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# AI Provider: "auto" (Gemini + OpenAI fallback), "gemini", or "openai"
AI_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# OpenAI API (required if AI_PROVIDER is "auto" or "openai")
OPENAI_API_KEY=your_openai_api_key

# Notion Configuration
NOTION_API_KEY=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Apify (Social Media Scraping)
APIFY_API_TOKEN=your_apify_api_token

# Google Drive (Image Upload)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Cloud Deployment (Zeabur)
# Set GOOGLE_CREDENTIALS_BASE64 to the base64-encoded credentials.json
# Generate with: base64 -w 0 credentials.json
# Set PORT if needed (auto-set by Zeabur, default 8000 for local dev)
